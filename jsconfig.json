{
  "compilerOptions": {
    "checkJs": true,
    "allowJs": true,
    "strict": false,
    "noEmit": true,
    "skipLibCheck": true,
    "lib": ["ESNext", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ESNext",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node", "jest"],
    "maxNodeModuleJsDepth": 0
  },
  "include": [
    "js/des-db/**/*",
    "js/des-savefile/**/*",
    "js/lib/ps3-save-lib/**/*",
    "js/lib/tauri-bridge.js",
    "js/ui/**/*",
    "tests/**/*",
    "tools/**/*",
    "rpcs3-mcp-server/src/**/*.js"
  ],
  "exclude": [
    "node_modules",
    "src-tauri",
    "integration-tests"
  ]
}