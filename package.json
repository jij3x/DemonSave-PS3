{
  "name": "demonsave-ps3",
  "version": "1.1.0",
  "description": "Browser-based Demon's Souls PS3 save editor",
  "license": "MIT",
  "type": "module",
  "main": "js/ui/app.js",
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:savefile": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/des-savefile",
    "test:ui": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/ui",
    "test:ps3-lib": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/lib/ps3-save-lib",
    "test:integration": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.integration.config.js",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:db": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/des-db",
    "pretest:db": "node tools/gen-des-db-index.mjs",
    "gen:db-index": "node tools/gen-des-db-index.mjs",
    "gen:icon": "node tools/gen-icon.mjs",
    "gen:version": "node tools/gen-version.mjs",
    "version:check": "node tools/gen-version.mjs --check",
    "lint:css": "stylelint css/**/*.css",
    "lint:js": "eslint js/ tests/ tools/ integration-tests/ fuzz/",
    "lint:types": "tsc --project jsconfig.json --noEmit",
    "lint": "npm run version:check && npm run lint:css && npm run lint:js && npm run lint:types",
    "format": "prettier --write \"js/**/*.js\" \"tests/**/*.js\" \"tools/**/*.mjs\" \"integration-tests/**/*.js\" \"fuzz/**/*.js\" *.js",
    "format:check": "prettier --check \"js/**/*.js\" \"tests/**/*.js\" \"tools/**/*.mjs\" \"integration-tests/**/*.js\" \"fuzz/**/*.js\" *.js",
    "serve:dev": "node tools/serve-dev.mjs",
    "build:frontend": "node tools/build-frontend.mjs",
    "fuzz:corpus": "node tools/gen-fuzz-corpus.mjs",
    "fuzz:smoke": "node tools/fuzz-smoke-all.mjs",
    "fuzz:readsave": "node tools/fuzz.mjs readsave",
    "fuzz:readsave:smoke": "node tools/fuzz.mjs readsave --smoke",
    "fuzz:pfd": "node tools/fuzz.mjs pfd",
    "fuzz:pfd:smoke": "node tools/fuzz.mjs pfd --smoke",
    "fuzz:sfo": "node tools/fuzz.mjs sfo",
    "fuzz:sfo:smoke": "node tools/fuzz.mjs sfo --smoke",
    "fuzz:roundtrip": "node tools/fuzz.mjs roundtrip",
    "fuzz:roundtrip:smoke": "node tools/fuzz.mjs roundtrip --smoke",
    "fuzz:pipeline": "node tools/fuzz.mjs pipeline",
    "fuzz:pipeline:smoke": "node tools/fuzz.mjs pipeline --smoke",
    "fuzz:encexport": "node tools/fuzz.mjs encexport",
    "fuzz:encexport:smoke": "node tools/fuzz.mjs encexport --smoke",
    "fuzz:saveapi": "node tools/fuzz.mjs saveapi",
    "fuzz:saveapi:smoke": "node tools/fuzz.mjs saveapi --smoke",
    "fuzz:crypto": "node tools/fuzz.mjs crypto",
    "fuzz:crypto:smoke": "node tools/fuzz.mjs crypto --smoke",
    "fuzz:pfdcreate": "node tools/fuzz.mjs pfdcreate",
    "fuzz:pfdcreate:smoke": "node tools/fuzz.mjs pfdcreate --smoke",
    "fuzz:pfdserialize": "node tools/fuzz.mjs pfdserialize",
    "fuzz:pfdserialize:smoke": "node tools/fuzz.mjs pfdserialize --smoke",
    "fuzz:savefolder": "node tools/fuzz.mjs savefolder",
    "fuzz:savefolder:smoke": "node tools/fuzz.mjs savefolder --smoke",
    "fuzz:sfofields": "node tools/fuzz.mjs sfofields",
    "fuzz:sfofields:smoke": "node tools/fuzz.mjs sfofields --smoke",
    "fuzz:cov": "c8 node tools/fuzz-coverage.mjs",
    "fuzz:branches": "node tools/fuzz-branches.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:dev:wsl": "WEBKIT_DISABLE_COMPOSITING_MODE=1 LIBGL_ALWAYS_SOFTWARE=1 tauri dev",
    "tauri:build": "tauri build",
    "tauri:icon": "tauri icon"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jazzer.js/core": "^4.0.0",
    "@tauri-apps/cli": "^2",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "c8": "^12.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.1",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "prettier": "^3.9.6",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@noble/ciphers": "^2.3.0",
    "@noble/hashes": "^2.3.0",
    "fflate": "^0.8.3"
  }
}
